{% extends 'base.html.j2' %}
{% from 'partials/paper.html.j2' import entry %}
{% block title %}{{ site.name }} | {{ site.title }}{% endblock %}

{% block head %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Person",
  "name": {{ site.name | tojson }},
  "jobTitle": {{ site.title | tojson }},
  "email": {{ ('mailto:' ~ site.email) | tojson }},
  "url": "https://jfimbett.github.io/",
  "affiliation": {"@type": "Organization", "name": {{ site.institution | tojson }}},
  "sameAs": {{ (site.profiles.values() | select | list) | tojson }}
}
</script>
{% endblock %}

{% block content %}
<section class="hero">
  <div class="wrap hero__grid">
    <div>
      <h1 class="hero__title">{{ site.name }}</h1>
      <p class="hero__role">{{ site.title }}</p>
      <p class="hero__institution">{{ site.institution }}</p>
      <hr class="rule">
      <p class="hero__intro">{{ site.intro }}</p>
      <p><a href="research.html">Research</a> · <a href="{{ site.cv }}">CV (PDF)</a> · <a href="mailto:{{ site.email }}">{{ site.email }}</a></p>
    </div>
    <picture>
      {% if site.photo_webp %}
      <source srcset="{{ site.photo_webp }}" type="image/webp">
      {% endif %}
      <img class="hero__portrait" src="{{ site.photo }}" width="369" height="560"
           alt="Portrait of {{ site.name }}">
    </picture>
  </div>
</section>

<section class="section section--tint" id="map">
  <div class="wrap">
    <p class="eyebrow">Research map</p>
    <h2 class="section__title">Papers in embedding space</h2>
    <p>Each point is a paper, placed by a two-dimensional projection of its
    text embedding. Papers that read alike sit together; colour marks the
    research agenda.</p>
    <figure class="plot">
      <canvas class="plot__canvas" id="plot-canvas" tabindex="0" role="img"
              aria-label="Scatter plot of {{ papers | length }} papers positioned by the similarity of their text and coloured by research agenda. The same papers are listed below.">
        <svg viewBox="0 0 100 100" width="100%" height="100%" aria-hidden="true" focusable="false">
          <rect width="100" height="100" fill="#FFFFFF"/>
          <circle cx="88.0" cy="62.0" r="2.6" fill="#A63446"/>
          <circle cx="82.5" cy="57.6" r="2.6" fill="#A63446"/>
          <circle cx="44.9" cy="33.5" r="2.6" fill="#007FB0"/>
          <circle cx="30.8" cy="81.8" r="2.6" fill="#5F1937"/>
          <circle cx="12.0" cy="73.4" r="2.6" fill="#5F1937"/>
          <circle cx="41.0" cy="39.5" r="2.6" fill="#007FB0"/>
          <circle cx="19.1" cy="66.2" r="2.6" fill="#5F1937"/>
          <circle cx="32.9" cy="18.2" r="2.6" fill="#6B5300"/>
          <circle cx="31.1" cy="20.6" r="2.6" fill="#007FB0"/>
        </svg>
      </canvas>
      <div class="plot__tooltip" id="plot-tooltip" aria-hidden="true"></div>
      <ul class="plot__legend">
        {% for agenda in agendas if agenda.id in papers | map(attribute='agenda') | list %}
        <li><span class="plot__swatch" data-agenda="{{ agenda.id }}"></span>{{ agenda.label }}</li>
        {% endfor %}
      </ul>
      <p class="plot__hint">Hover or focus a point for the full title; click to open the paper.</p>
      <figcaption class="visually-hidden">
        Papers shown in the map:
        <ul>{% for paper in papers %}<li><a href="research.html#{{ paper.id }}">{{ paper.title }}</a></li>{% endfor %}</ul>
      </figcaption>
    </figure>
  </div>
</section>


<section class="section">
  <div class="wrap">
    <p class="eyebrow">Selected work</p>
    <h2 class="section__title">Publications</h2>
    {% for paper in grouped.published %}
    {{ entry(paper, loop.index) }}
    {% endfor %}
    <p class="section__more"><a href="research.html">All research →</a></p>
  </div>
</section>
{% endblock %}

{% block scripts %}
<script type="module" src="assets/js/hero.js"></script>
{% endblock %}
